# Ambiente: "production" usa mainnet + Arbitrum One; outro valor usa testnets
VITE_APP_ENV=
# ID de projeto WalletConnect (dashboard.walletconnect.com); sem ele o WalletConnect fica desativado
VITE_WALLETCONNECT_PROJECT_ID=
# Chave publicável da Magic; sem ela o login por e-mail/Google fica desativado
VITE_MAGIC_PUBLISHABLE_KEY=
# Opcional: rpId do WebAuthn (passkey). Padrão: p2pix.co / demo.p2pix.co e localhost (dev); em outras origens
# o passkey fica desativado, e o rpId deve servir https://<rpId>/.well-known/webauthn
VITE_PASSKEY_RP_ID=
# Política de patrocínio da Pimlico; habilita a conta inteligente e o login com passkey
VITE_PIMLICO_SPONSORSHIP_POLICY_ID=
